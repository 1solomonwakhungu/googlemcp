# GoogleMCP configuration example. Every GOOGLEMCP_* setting with its default.
# The server does not read a .env file: export these in your shell (for
# `googlemcp auth login` and the other CLI commands) and set the same values in
# your MCP client's `env` block, or put them in ~/.config/googlemcp/config.toml.
# The server runs locally over stdio only, started by your MCP client.
# Non-secret settings only. Secrets live in a secret store, never in this file:
#   googlemcp auth login --client-secrets <downloaded Desktop client JSON>
#   googlemcp secret set <key>

# Products (catalog keys). Unset means the catalog defaults.
# GOOGLEMCP_PRODUCTS=tasks,calendar,drive,gmail
# Products whose write tools and write scopes are enabled ("all" for every enabled product).
GOOGLEMCP_WRITE_PRODUCTS=
# Destructive tools (delete, trash, send) need this too.
GOOGLEMCP_ALLOW_DESTRUCTIVE=false

# Secret backend: keyring (default), file, dir, env, secretmanager.
GOOGLEMCP_SECRET_BACKEND=keyring
# GOOGLEMCP_SECRET_FILE=~/.config/googlemcp/secrets.json
# GOOGLEMCP_SECRETS_DIR=~/.config/googlemcp/secrets.d
# GOOGLEMCP_GCP_PROJECT=your-project-id
# GOOGLEMCP_SECRET_PREFIX=googlemcp

GOOGLEMCP_MAX_RETRIES=4
GOOGLEMCP_LOG_LEVEL=INFO

# Path to a TOML settings file (default ~/.config/googlemcp/config.toml if it exists).
# GOOGLEMCP_CONFIG=~/.config/googlemcp/config.toml
